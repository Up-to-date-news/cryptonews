# Set these in the Vercel/Netlify dashboard's environment variable settings —
# never commit real values, never expose them to client-side code.

# Checked server-side by api/admin-login.js. Single-operator gate only.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Secret used to sign the admin session token issued on login. Any long
# random string — generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN_SECRET=

# GitHub Personal Access Token with repo write access (contents: write).
# Used only inside serverless functions to commit new articles/tags.
GITHUB_TOKEN=

# Repo the pipeline and admin functions both write to.
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_BRANCH=main
