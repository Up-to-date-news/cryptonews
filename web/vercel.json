{
  "rewrites": [
    {
      "source": "/article/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(Googlebot|Google-Extended|Bingbot|DuckDuckBot|Baiduspider|YandexBot|Applebot|Applebot-Extended|GPTBot|ChatGPT-User|OAI-SearchBot|CCBot|ClaudeBot|Claude-Web|anthropic-ai|PerplexityBot|Perplexity-User|AI2Bot|cohere-ai|Diffbot|YouBot|Timpibot|ImagesiftBot|omgili|facebookexternalhit|meta-externalfetcher|Twitterbot|LinkedInBot|Slackbot|WhatsApp|TelegramBot|Discordbot|redditbot|Bytespider|PetalBot|Amazonbot|meta-externalagent).*"
        }
      ],
      "destination": "/api/prerender-article?slug=:slug"
    },
    {
      "source": "/event/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(Googlebot|Google-Extended|Bingbot|DuckDuckBot|Baiduspider|YandexBot|Applebot|Applebot-Extended|GPTBot|ChatGPT-User|OAI-SearchBot|CCBot|ClaudeBot|Claude-Web|anthropic-ai|PerplexityBot|Perplexity-User|AI2Bot|cohere-ai|Diffbot|YouBot|Timpibot|ImagesiftBot|omgili|facebookexternalhit|meta-externalfetcher|Twitterbot|LinkedInBot|Slackbot|WhatsApp|TelegramBot|Discordbot|redditbot|Bytespider|PetalBot|Amazonbot|meta-externalagent).*"
        }
      ],
      "destination": "/api/prerender-event?slug=:slug"
    },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/data/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=120, s-maxage=300, stale-while-revalidate=3600" }
      ]
    },
    {
      "source": "/logos/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
